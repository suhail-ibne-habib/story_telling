{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "chunk-analysis.schema.json",
    "title": "Chunk Analysis",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "chunkId",
        "timeline",
        "summary",
        "events",
        "characters",
        "locations",
        "visualHighlights",
        "dialogueHighlights",
        "importantObjects",
        "emotionalTone",
        "questionsRaised",
        "confidence"
    ],
    "properties": {
        "chunkId": {
            "type": "string",
            "pattern": "^CH\\d{4}$"
        },
        "timeline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "start",
                "end"
            ],
            "properties": {
                "start": {
                    "type": "number"
                },
                "end": {
                    "type": "number"
                }
            }
        },
        "summary": {
            "type": "string",
            "minLength": 1
        },
        "events": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/event"
            }
        },
        "characters": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/character"
            }
        },
        "locations": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/location"
            }
        },
        "visualHighlights": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "dialogueHighlights": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "importantObjects": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "emotionalTone": {
            "type": "string"
        },
        "questionsRaised": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
        }
    },
    "$defs": {
        "event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "description",
                "importance"
            ],
            "properties": {
                "title": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "importance": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                }
            }
        },
        "character": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "role"
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "role": {
                    "type": "string",
                    "enum": [
                        "main",
                        "supporting",
                        "background",
                        "unknown"
                    ]
                }
            }
        },
        "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string"
                }
            }
        }
    }
}